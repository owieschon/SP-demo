# Copy to .env and fill in what you need. Everything is optional for a local run.

# Supabase Postgres, transaction pooler (port 6543). Leave empty to run on a
# local PGlite database built from ../db.
DATABASE_URL=

# Signs the session cookie. Required when deployed; a random one is used locally if empty.
SESSION_SECRET=

# Folder for the local PGlite database (default .pglite).
PGLITE_DIR=

# Live assistant mode (later milestones). Mock mode needs neither.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
LIVE_AI_PASSPHRASE=
